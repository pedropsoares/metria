// Signing configuration for local development.
//
// Running on a real iPhone requires a development team. Create a `Local.xcconfig`
// next to this file (it is gitignored) containing your team identifier:
//
//     DEVELOPMENT_TEAM = ABCDE12345
//
// Find it in Xcode under Settings > Accounts > (your Apple ID) > Manage Certificates,
// or at https://developer.apple.com/account under Membership details.
//
// Leaving it unset still builds for the simulator; it only blocks device installs.

#include? "Local.xcconfig"

CODE_SIGN_STYLE = Automatic
